# --- Embedding ---
# Currently only `qwen` is implemented. `ark` / `local_bge` are reserved.
EMBEDDING_PROVIDER=qwen

# Qwen (qianwenai.com / Alibaba Cloud Bailian)
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIM=1024

# Volcano Ark (optional)
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_EMBEDDING_MODEL=doubao-embedding-large-text-250515

# --- LLM ---
# Set LLM_API_KEY / LLM_BASE_URL / LLM_MODEL.
# Or leave LLM_API_KEY/LLM_BASE_URL empty and use ARK_API_KEY/ARK_BASE_URL.
# LLM_MODEL must be a model id available to YOUR account.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=your-model-id
